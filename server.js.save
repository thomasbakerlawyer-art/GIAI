app.post(
"/approve-reinvestment",
(req,res)=>{

const { id } =
req.body;

const requests =
JSON.parse(
fs.readFileSync(
"reinvestments.json",
"utf8"
)
);

const request =
requests.find(
r => r.id == id
);

if(!request){

return res.json({
success:false
});

}

const users =
getUsers();

const user =
users.find(
u =>
u.email ===
request.email
);

if(!user){

return res.json({
success:false
});

}

const freshMoney =
Number(
request.topup || 0
);

const reinvestAmount =

Number(
request.profit || 0
)
+
freshMoney;

user.investmentAmount =

Number(
user.investmentAmount || 0
)
+
reinvestAmount;

user.investmentStart =
Date.now();

request.status =
"APPROVED";

/* votes only on fresh money */

if(
freshMoney > 0
){

const votes =
Math.floor(
freshMoney / 500
);

user.totalVotes += votes;

}

saveUsers(users);

fs.writeFileSync(
"reinvestments.json",
JSON.stringify(
requests,
null,
2
)
);

res.json({
success:true
});

});

const CHAT_FILE =
path.join(
__dirname,
"database",
"chatMessages.json"
);

app.post("/send-chat",(req,res)=>{

const {
email,
message
} = req.body;

const chats =
JSON.parse(
fs.readFileSync(CHAT_FILE)
);

chats.push({

id:Date.now(),

email,

message,

sender:"user",

date:new Date(),

status:"NEW"

});

fs.writeFileSync(
CHAT_FILE,
JSON.stringify(
chats,
null,
2
)
);

res.json({
success:true
});

});

app.get("/admin-chat",(req,res)=>{

const chats =
JSON.parse(
fs.readFileSync(CHAT_FILE)
);

res.json({
chats
});

});

