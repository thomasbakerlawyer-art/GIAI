/* =========================
   APPROVE DEPOSIT
========================= */

app.post("/approve-deposit",(req,res)=>{

const { id } = req.body;

const deposits =
getDeposits();

const deposit =
deposits.find(
d => d.id == id
);

if(!deposit){

return res.json({
success:false,
message:"Deposit not found"
});

}

if(deposit.status === "APPROVED"){

return res.json({
success:false,
message:"Already approved"
});

}

deposit.status = "APPROVED";

const users =
getUsers();

const user =
users.find(
u => u.email === deposit.email
);

if(user){

user.investmentStart = Date.now();

user.reinvestmentCount = 0;

user.balance +=
Number(deposit.amount);

const topup =
Number(deposit.amount);

if(

topup >=

(

Number(
user.investmentAmount || 0
)

* 0.20

)

){

user.reinvestmentCount = 0;

}

if(user.balance >= 50000){

user.rank = "Elite Investor";

}

else if(user.balance >= 15000){

user.rank = "VIP Investor";

}

else if(user.balance >= 5000){

user.rank = "Premium Investor";

}

else if(user.balance >= 1000){

user.rank = "Standard Investor";

}

else{

user.rank = "Starter Investor";

}

user.investmentAmount =
Number(user.investmentAmount || 0)
+
Number(deposit.amount);

user.plan =
deposit.plan;

user.representative =
deposit.representative;

user.investmentStart =
Date.now();

if(
deposit.representative
){

const reps =
getRepresentatives();

const rep =
reps.find(
r =>
r.name ===
deposit.representative
);

if(rep){

const votes =
Math.floor(
Number(deposit.amount)/500
);

rep.votes += votes;

/* USER VOTES */

user.totalVotes =
Number(
user.totalVotes || 0
)
+
votes;

/* PLAN */

const amount =
Number(user.investmentAmount);

if(amount >= 200 && amount <= 999){

user.plan = "Starter Plan";

user.profitPercent = 25;

user.investmentDuration = 1;

}

else if(amount >= 1000 && amount <= 2999){

user.plan = "Standard Plan";

user.profitPercent = 45;

user.investmentDuration = 2;

}

else if(amount >= 3000 && amount <= 7999){

user.plan = "Premium Plan";

user.profitPercent = 55;

user.investmentDuration = 5;

}

else if(amount >= 8000 && amount <= 14999){

user.plan = "Contact Manager";

user.profitPercent = 85;

user.investmentDuration = 14;

}

else if(amount >= 15000 && amount <= 44999){

user.plan = "Capital Boost";

user.profitPercent = 95;

user.investmentDuration = 22;

}

else if(amount >= 45000){

user.plan = "Rapid Return";

user.profitPercent = 100.15;

user.investmentDuration = 35;

}

saveRepresentatives(reps);

}

}

if(user.pendingRepresentative){

user.representative =
user.pendingRepresentative;

}

if(user.pendingPlan){

user.plan =
user.pendingPlan;

}

user.transactions.unshift({

type:"DEPOSIT APPROVED",

amount:deposit.amount,

date:new Date()

});

if(user.balance >= 1000){

user.rank =
"Silver Investor";

}

if(user.balance >= 5000){

user.rank =
"Gold Investor";

}

if(user.balance >= 10000){

user.rank =
"VIP Investor";

}

saveUsers(users);

}

saveDeposits(deposits);

res.json({

success:true,
message:"Deposit approved"

});

});

/* =========================
   REJECT DEPOSIT
========================= */

app.post("/reject-deposit",(req,res)=>{

const { id } = req.body;

const deposits =
getDeposits();

const deposit =
deposits.find(
d => d.id == id
);

if(!deposit){

return res.json({
success:false,
message:"Deposit not found"
});

}

deposit.status = "REJECTED";

saveDeposits(deposits);

res.json({

success:true,
message:"Deposit rejected"

});

});

/* =========================
   CLAIM PROFIT
========================= */

app.post("/claim-profit",(req,res)=>{

const { email } = req.body;

const users = getUsers();

const user =
users.find(
u => u.email === email
);

if(!user){

return res.json({
success:false,
message:"User not found"
});

}

if(user.plan === "None"){

return res.json({
success:false,
message:"No active plan"
});

}

let profit =

Math.floor(

Number(
user.investmentAmount || 0
)

*

(

Number(
user.profitPercent || 0
)

/

100

)

);

user.claimableProfit =
Number(user.claimableProfit || 0)
+
profit;

user.transactions.unshift({

type:"PROFIT GENERATED",

amount:profit,

date:new Date()

});

saveUsers(users);

res.json({

success:true,

message:"Profit generated",

profit,

claimableProfit:
user.claimableProfit,

user

});

return;

app.post("/reinvest-profit",(req,res)=>{

const { email, amount } = req.body;

const users = getUsers();

const user =
users.find(
u => u.email === email
);

if(!user){

return res.json({
success:false
});

}

amount = Number(amount);

if(
amount >
Number(user.claimableProfit || 0)
){

return res.json({
success:false,
message:"Insufficient profit"
});

}

/* REINVESTMENT RULES */

const currentInvestment =
Number(
user.investmentAmount || 0
);

const requiredIncrease =
currentInvestment * 0.20;

/* Starter can only reinvest once */

if(
user.plan === "Starter Plan" &&
Number(
user.reinvestmentCount || 0
) >= 1
){

return res.json({
success:false,
message:
"Starter Plan can only reinvest once"
});

}

/* Other plans max twice unless topup */

if(
amount < requiredIncrease &&
Number(
user.reinvestmentCount || 0
) >= 2
){

return res.json({
success:false,
message:
"Add at least 20% more capital to continue reinvesting"
});

}

user.claimableProfit -= amount;

user.balance += amount;

user.investmentAmount =
Number(
user.investmentAmount || 0
)
+
amount;

user.reinvestmentCount =
Number(
user.reinvestmentCount || 0
)
+
1;

user.transactions.unshift({

type:"REINVESTMENT",

amount,

date:new Date()

});

saveUsers(users);

res.json({

success:true,
message:"Reinvestment successful"

});

});

saveUsers(users);

res.json({

success:true,

message:"Profit added successfully",

profit,

user

});

});

app.post("/reinvest-profit",(req,res)=>{

const { email } = req.body;

const users = getUsers();

const user =
users.find(
u => u.email === email
);

if(!user){

return res.json({
success:false,
message:"User not found"
});

}

const limit =
getReinvestmentLimit(
user.plan
);

const count =
Number(
user.reinvestmentCount || 0
);

if(count >= limit){

return res.json({

success:false,

message:
"Reinvestment limit reached. Please top up at least 20%."

});

}

const profit =

Math.floor(

Number(
user.investmentAmount || 0
)

*

(

Number(
user.profitPercent || 0
)

/

100

)

);

user.investmentAmount += profit;

user.reinvestmentCount += 1;

user.transactions.unshift({

type:"PROFIT REINVESTED",

amount:profit,

date:new Date()

});

saveUsers(users);

res.json({

success:true,

message:
"Profit reinvested",

user

});

});

/* =========================
   SERVER
========================= */

app.post("/request-withdrawal",(req,res)=>{

const {
email,
amount
} = req.body;

const users =
getUsers();

const user =
users.find(
u=>u.email===email
);

if(!user){

return res.json({
success:false,
message:"User not found"
});

}

const now =
Date.now();

const endTime =

(user.investmentStart || 0)
+
(
(user.investmentDuration || 0)
*
86400000
);

if(
user.investmentAmount > 0
&&
now < endTime
){

return res.json({

success:false,

message:
"Investment still active. Capital cannot be withdrawn."

});

}

const withdrawalsFile =
path.join(
__dirname,
"database",
"withdrawals.json"
);

const withdrawals =
JSON.parse(
fs.readFileSync(withdrawalsFile)
);

const newWithdrawal = {

id:Date.now(),

email,

amount,

status:"PENDING",

date:new Date()

};

withdrawals.push(newWithdrawal);

fs.writeFileSync(
withdrawalsFile,
JSON.stringify(withdrawals,null,2)
);

res.json({

success:true,

message:
"Withdrawal request submitted"

});

});

/* =========================
   ADMIN WITHDRAWALS
========================= */

app.get("/admin-withdrawals",(req,res)=>{

const withdrawalsFile =
path.join(
__dirname,
"database",
"withdrawals.json"
);

if(!fs.existsSync(withdrawalsFile)){

fs.writeFileSync(
withdrawalsFile,
"[]"
);

}

const withdrawals =
JSON.parse(
fs.readFileSync(withdrawalsFile)
);

res.json({
withdrawals
});

});

/* =========================
   APPROVE WITHDRAWAL
========================= */

app.post("/approve-withdrawal",(req,res)=>{

const { id } = req.body;

const withdrawalsFile =
path.join(
__dirname,
"database",
"withdrawals.json"
);

const withdrawals =
JSON.parse(
fs.readFileSync(withdrawalsFile)
);

const withdrawal =
withdrawals.find(
w => w.id === id
);

if(!withdrawal){

return res.json({
success:false,
message:"Withdrawal not found"
});

}

if(withdrawal.status === "APPROVED"){

return res.json({
success:false,
message:"Already approved"
});

}

const users = getUsers();

const user =
users.find(
u => u.email === withdrawal.email
);

if(!user){

return res.json({
success:false,
message:"User not found"
});

}

if(user.balance < Number(withdrawal.amount)){

return res.json({
success:false,
message:"Insufficient balance"
});

}

const amount =
Number(withdrawal.amount);

if(
user.balance < amount
){

return res.json({

success:false,

message:
"Insufficient balance"

});

}

user.balance -= amount;

const removedVotes =
Math.floor(amount / 500);

user.totalVotes =
Math.max(
0,
(user.totalVotes || 0)
-
removedVotes
);

if(user.balance >= 50000){

user.rank =
"Elite Investor";

}

else if(
user.balance >= 15000
){

user.rank =
"VIP Investor";

}

else if(
user.balance >= 5000
){

user.rank =
"Premium Investor";

}

else if(
user.balance >= 1000
){

user.rank =
"Standard Investor";

}

else{

user.rank =
"Starter Investor";

}

if(user.balance <= 0){

user.plan = "None";

user.investmentAmount = 0;

user.investmentStart = 0;

user.profitPercent = 0;

user.investmentDuration = 0;

}

user.transactions.unshift({

type:"WITHDRAWAL APPROVED",

amount:withdrawal.amount,

date:new Date()

});

withdrawal.status =
"APPROVED";

saveUsers(users);

fs.writeFileSync(

withdrawalsFile,

JSON.stringify(
withdrawals,
null,
2
)

);

res.json({

success:true,

message:"Withdrawal approved"

});

});

